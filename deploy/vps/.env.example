# Copie para .env (nunca versionar) e preencha. Gere segredos com: openssl rand -base64 48
CLOUDFLARE_TUNNEL_TOKEN=
API_IMAGE=gustavodamassa/pricewatch-api:latest

MONGO_USER=pricewatch
MONGO_PASSWORD=
MONGO_DATABASE=pricewatch_db

JWT_SECRET=
JWT_ISSUER=pricewatch
JWT_AUDIENCE=pricewatch-clients
JWT_EXPIRY_HOURS=24

# Amazon SES (SMTP) ou Resend; remetente em domínio verificado (SPF/DKIM)
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FRONTEND_BASE_URL=https://pricewatch.gustavohdev.com.br
ALLOWED_ORIGIN_SITE=https://pricewatch.gustavohdev.com.br

MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
LOMADEE_APP_TOKEN=
LOMADEE_SOURCE_ID=

# Push (Firebase): JSON da conta de serviço em base64 (base64 -w0 arquivo.json)
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON_BASE64=

# Flags: ligue na ordem do runbook-cutover.md
FEATURE_BACKFILL_ENABLED=false
FEATURE_MATCHING_ENABLED=false
FEATURE_UNIFIED_CATALOG_ENABLED=false

# Backup (scripts/backup-mongo.sh): bucket S3-compatível
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_RETENTION_DAYS=14
